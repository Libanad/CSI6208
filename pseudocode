START PROGRAM

IMPORT random

DISPLAY "Welcome to Guess Game"

REPEAT

    candidateWords ← ['AETHER', 'BADGED', 'BALDER', ... , 'YONDER']

    wordList ← randomly select 8 words from candidateWords

    password ← randomly select 1 word from wordList

    guessesRemaining ← 4

    won ← False

    guessedWords ← empty dictionary


    WHILE guessesRemaining > 0 AND won = False

        CALL displayWordList(wordList, guessedWords)

        DISPLAY "Guesses Remaining:", guessesRemaining

        CALL validateInput() → choice

        IF choice = NULL
            CONTINUE
        ENDIF

        guess ← wordList[choice]

        IF guess exists in guessedWords
            DISPLAY "You already guessed this word"
            CONTINUE
        ENDIF

        guessesRemaining ← guessesRemaining − 1

        IF guess = password

            DISPLAY "The Password Is Correct!"

            won ← True

        ELSE

            CALL compareWords(password, guess) → match

            guessedWords[guess] ← match

            DISPLAY "The Password is Incorrect"

            DISPLAY match "/6 letters correct"

        ENDIF

    ENDWHILE


    IF won = True

        DISPLAY "Congratulationnnnn You Win!"

    ELSE

        DISPLAY "Sorry You Lose!"

        DISPLAY "Password was:", password

    ENDIF


    CALL playAgain() → play

UNTIL play = False


DISPLAY "Thanks for playing!"

END PROGRAM



FUNCTION compareWords(word1, word2)

    count ← 0

    FOR i ← 0 to length(word1) − 1

        IF word1[i] = word2[i]

            count ← count + 1

        ENDIF

    ENDFOR

RETURN count

END FUNCTION



FUNCTION displayWordList(wordList, guessedWords)

    DISPLAY "Word List"

    FOR i ← 0 to length(wordList) − 1

        word ← wordList[i]

        IF word exists in guessedWords

            DISPLAY i + 1 , word , guessedWords[word] , "/6"

        ELSE

            DISPLAY i + 1 , word

        ENDIF

    ENDFOR

END FUNCTION



FUNCTION validateInput()

    TRY

        INPUT choice

        choice ← choice − 1

        IF choice < 0 OR choice > 7

            DISPLAY "The number must be between 1 and 8. Invalid input"

            RETURN NULL

        ENDIF

        RETURN choice

    CATCH error

        DISPLAY "Invalid input"

        RETURN NULL

END FUNCTION



FUNCTION playAgain()

    INPUT "Do You want to play again? (yes/no): " → answer

    CONVERT answer to lowercase

    IF answer = "yes"

        RETURN True

    ELSE

        RETURN False

    ENDIF

END FUNCTION