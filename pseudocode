START PROGRAM
IMPORT random
FUNCTION compareWords(word1, word2)
    SET count = 0
    FOR each letter position in word1
        IF letter in word1 equals letter in word2
            count = count + 1
        ENDIF
    ENDFOR
    RETURN count
END FUNCTION


FUNCTION main

    CREATE list candidateWords with 100 words

    PRINT "Welcome to Guess Game"

    WHILE user wants to play

        SELECT 8 random words from candidateWords → wordList
        SELECT random word from wordList → password

        SET guessesRemaining = 4
        SET won = False

        CREATE empty dictionary guessedWords

        WHILE guessesRemaining > 0 AND won = False

            DISPLAY wordList

            FOR each word in wordList
                IF word already guessed
                    SHOW word with matching letters
                ELSE
                    SHOW word normally
                ENDIF
            ENDFOR

            PRINT guesses remaining

            TRY
                GET user input (1-8)
                CONVERT input to number
            CATCH error
                PRINT "Invalid input"
                CONTINUE
            END TRY

            GET guessed word

            IF word already guessed
                PRINT "Already guessed"
                CONTINUE
            ENDIF

            guessesRemaining = guessesRemaining − 1

            IF guessed word = password
                PRINT "Password Correct"
                SET won = True
            ELSE
                CALL compareWords
                STORE matching letters
                PRINT matching result
            ENDIF

        ENDWHILE

        IF won = True
            PRINT "You Win"
        ELSE
            PRINT "You Lose"
            PRINT password
        ENDIF

        ASK "Play Again?"

        IF answer not yes
            EXIT program
        ENDIF

    ENDWHILE

END FUNCTION

CALL main

END PROGRAM